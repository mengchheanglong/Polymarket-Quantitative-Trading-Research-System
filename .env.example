# Safe paper-trading config only.
DRY_RUN=true
EXECUTION_MODE=paper
DATABASE_PATH=paper_trading.sqlite3

STARTING_BALANCE=1000
MAX_POSITION_PCT=0.05
MAX_POSITION_USD=100
MAX_TRADE_USD=1.00
MAX_TOTAL_EXPOSURE_USD=10.00
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_MARKET=1
MAX_TRADES_PER_SESSION=100
SESSION_LOSS_LIMIT_USD=5.00
DAILY_LOSS_LIMIT_USD=10.00
COOLDOWN_AFTER_LOSS_SECONDS=300
MIN_EDGE=0.02
MAX_SPREAD=0.10

FEE_BPS=10
SLIPPAGE_BPS=25
ASSUMED_SPREAD=0.02
FAILED_FILL_PROBABILITY=0
PAIR_COST_THRESHOLD=0.98
PAIR_COST_FAILED_SECOND_LEG_PROBABILITY=0
STUCK_STATE_MIN_CYCLES=3
STUCK_PRICE_BUCKET_MIN=0.70
STUCK_PRICE_BUCKET_MAX=0.80
STUCK_MAX_SPREAD=0.02
STUCK_MIN_SECONDS_TO_EXPIRY=30
STUCK_MAX_SECONDS_TO_EXPIRY=180
STRATEGY=momentum
CLOSE_MODE=expiry-if-known
TINY_PROFILE=false

MIN_SECONDS_BEFORE_END=45
MIN_SECONDS_TO_EXPIRY=30
MAX_SECONDS_TO_EXPIRY=240
MAX_MARKET_DURATION_MINUTES=60
USE_DEMO_MARKETS=false
USE_MOCK_DATA=false
RANDOM_SEED=7

GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
COINBASE_BASE_URL=https://api.exchange.coinbase.com
KRAKEN_BASE_URL=https://api.kraken.com
EXCHANGE_MAX_DIVERGENCE_PCT=0.001
